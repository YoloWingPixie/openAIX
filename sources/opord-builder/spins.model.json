{
  "$defs": {
    "AddBlock": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sibling after which to insert; omitted means append.",
          "title": "After"
        },
        "before": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sibling before which to insert; mutually exclusive with after.",
          "title": "Before"
        },
        "block": {
          "discriminator": {
            "mapping": {
              "figure": "#/$defs/FigureBlock",
              "list": "#/$defs/ListBlock",
              "note": "#/$defs/NoteBlock",
              "paragraph": "#/$defs/Paragraph",
              "reference": "#/$defs/ReferenceBlock",
              "section": "#/$defs/Section",
              "source_table": "#/$defs/SourceTableBlock",
              "table": "#/$defs/TableBlock"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Section"
            },
            {
              "$ref": "#/$defs/Paragraph"
            },
            {
              "$ref": "#/$defs/ListBlock"
            },
            {
              "$ref": "#/$defs/TableBlock"
            },
            {
              "$ref": "#/$defs/SourceTableBlock"
            },
            {
              "$ref": "#/$defs/FigureBlock"
            },
            {
              "$ref": "#/$defs/NoteBlock"
            },
            {
              "$ref": "#/$defs/ReferenceBlock"
            }
          ],
          "title": "Block"
        },
        "op": {
          "const": "add",
          "title": "Op",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Section/paragraph container; omitted means document root.",
          "title": "Parent"
        }
      },
      "required": [
        "op",
        "block"
      ],
      "title": "AddBlock",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "citation": {
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Citation",
          "type": "string"
        },
        "text": {
          "anyOf": [
