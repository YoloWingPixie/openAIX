        },
        "key": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Key",
          "type": "string"
        }
      },
      "required": [
        "key",
        "heading",
        "field"
      ],
      "title": "SourceColumn",
      "type": "object"
    },
    "SourceTableBlock": {
      "additionalProperties": false,
      "properties": {
        "caption": {
          "minLength": 1,
          "title": "Caption",
          "type": "string"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/SourceColumn"
          },
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stable name for links or amendments; printed numbers are automatic.",
          "title": "Id"
        },
        "kind": {
          "const": "source_table",
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "description": "Local standalone data-source YAML, relative to the owning SPINS file.",
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "caption",
        "source",
        "columns"
      ],
      "title": "SourceTableBlock",
      "type": "object"
    },
    "TableBlock": {
      "additionalProperties": false,
      "properties": {
        "caption": {
          "minLength": 1,
          "title": "Caption",
          "type": "string"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/TableColumn"
          },
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stable name for links or amendments; printed numbers are automatic.",
          "title": "Id"
        },
        "kind": {
          "const": "table",
          "title": "Kind",
          "type": "string"
        },
        "rows": {
          "items": {
            "patternProperties": {
              "^[a-z][a-z0-9_]*$": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "items": {
                      "anyOf": [
                        {
                          "$ref": "#/$defs/TextRun"
                        },
                        {
                          "$ref": "#/$defs/CrossReference"
                        },
                        {
                          "$ref": "#/$defs/Citation"
                        }
                      ]
                    },
                    "minItems": 1,
                    "type": "array"
                  }
                ]
              }
            },
            "type": "object"
          },
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "caption",
        "columns",
        "rows"
      ],
      "title": "TableBlock",
      "type": "object"
    },
    "TableColumn": {
      "additionalProperties": false,
      "properties": {
        "align": {
          "default": "left",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "title": "Align",
          "type": "string"
        },
        "heading": {
          "minLength": 1,
          "title": "Heading",
          "type": "string"
        },
        "key": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Key",
          "type": "string"
        }
      },
      "required": [
        "key",
        "heading"
      ],
      "title": "TableColumn",
      "type": "object"
    },
    "TextRun": {
      "additionalProperties": false,
      "description": "Inline text preserves spaces between adjacent runs.",
      "properties": {
        "marks": {
          "items": {
            "enum": [
              "bold",
              "italic",
              "underline",
              "code"
            ],
            "type": "string"
          },
          "title": "Marks",
          "type": "array"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "TextRun",
      "type": "object"
    }
  },
  "$id": "https://github.com/opord-builder/opord-builder/schemas/spins.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Ordered publication blocks with automatic numbering and optional standing amendments.",
  "properties": {
    "base": {
      "anyOf": [
        {
          "$ref": "#/$defs/PinnedPublication"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "changes": {
      "items": {
        "discriminator": {
          "mapping": {
            "add": "#/$defs/AddBlock",
            "remove": "#/$defs/RemoveBlock",
            "replace": "#/$defs/ReplaceBlock"
          },
          "propertyName": "op"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/AddBlock"
          },
          {
            "$ref": "#/$defs/ReplaceBlock"
          },
          {
            "$ref": "#/$defs/RemoveBlock"
          }
        ]
      },
      "title": "Changes",
      "type": "array"
    },
    "content": {
      "description": "Instructions in reading order. Numbering follows the effective hierarchy after amendments.",
      "items": {
        "discriminator": {
          "mapping": {
            "figure": "#/$defs/FigureBlock",
            "list": "#/$defs/ListBlock",
            "note": "#/$defs/NoteBlock",
            "paragraph": "#/$defs/Paragraph",
            "reference": "#/$defs/ReferenceBlock",
            "section": "#/$defs/Section",
            "source_table": "#/$defs/SourceTableBlock",
            "table": "#/$defs/TableBlock"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/Section"
          },
          {
            "$ref": "#/$defs/Paragraph"
          },
          {
            "$ref": "#/$defs/ListBlock"
          },
          {
            "$ref": "#/$defs/TableBlock"
          },
          {
            "$ref": "#/$defs/SourceTableBlock"
          },
          {
            "$ref": "#/$defs/FigureBlock"
          },
          {
            "$ref": "#/$defs/NoteBlock"
          },
          {
            "$ref": "#/$defs/ReferenceBlock"
          }
        ]
      },
      "title": "Content",
      "type": "array"
    },
    "kind": {
      "const": "spins",
      "title": "Kind",
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/PublicationMetadata"
    },
    "period": {
      "anyOf": [
        {
          "$ref": "#/$defs/PublicationPeriod"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "presentation": {
      "$ref": "#/$defs/Presentation"
    },
    "schema_version": {
      "const": "0.3",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "enum": [
        "standing",
        "mission"
      ],
      "title": "Scope",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "meta",
    "scope"
  ],
  "title": "SPINS",
  "type": "object"
}
